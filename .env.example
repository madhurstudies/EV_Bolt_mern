# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string (Connect > Drivers) - see README
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=ev_bolts

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too

# Only if mongodb+srv lookups fail locally (querySrv ECONNREFUSED)
# DNS_SERVERS=8.8.8.8,1.1.1.1
